rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Settings & Products: public read/write (due to no Firebase Auth integration) ──
    match /config/{docId} {
      allow read, write: if true;
    }

    match /products/{docId} {
      allow read, write: if true;
    }

    // ── Orders: public create (checkout) and public read/update ──
    match /orders/{docId} {
      allow create, read, update, delete: if true;
    }

    // ── All other documents: open ──
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
